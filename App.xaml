<Application x:Class="OcrTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OcrTool.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <DropShadowEffect x:Key="Shadow" BlurRadius="10" Opacity="0.2" Direction="270"/>
            
            <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <local:DragOverBrushConverter x:Key="DragOverBrushConverter"/>
            <local:DragOverBorderConverter x:Key="DragOverBorderConverter"/>
            
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="Background" Value="#FF4A90D9"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF3A80C9"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FF2A70B9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="#FFE8E8E8"/>
                <Setter Property="Foreground" Value="#FF333333"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFD8D8D8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="DragDropArea" TargetType="Border">
                <Setter Property="BorderBrush" Value="#FF4A90D9"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="#FFF5F8FC"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>