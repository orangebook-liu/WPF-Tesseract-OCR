<Window x:Class="OcrTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="离线OCR文字识别工具 v1.0"
        Height="700" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave">

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20" Effect="{StaticResource Shadow}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource AccentButton}"
                        Command="{Binding SelectImageCommand}"
                        Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="20" Height="20" Fill="White"
                              Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 4l8 5 8-5v-2l-8 5-8-5v2z"
                              Margin="0,0,8,0" Stretch="Fill"/>
                        <TextBlock Text="选择图片"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource AccentButton}"
                        Command="{Binding CaptureScreenCommand}"
                        Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="20" Height="20" Fill="White"
                              Data="M5 3h14c1.1 0 2 .9 2 2v14c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V5c0-1.1.9-2 2-2zm4 14h7v-2H9v2zm3-4h10v-2H12v2zm0-4h10V7H12v2z"
                              Margin="0,0,8,0"/>
                        <TextBlock Text="截取屏幕"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCommand}"
                        Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="20" Height="20" Fill="#FF333333"
                              Data="M19 6.4L17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.6 17.6 19 19 17.6 13.6 12z"
                              Margin="0,0,5,0"/>
                        <TextBlock Text="清空" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopyTextCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="20" Height="20" Fill="#FF333333"
                              Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                              Margin="0,0,5,0"/>
                        <TextBlock Text="复制结果" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#FF4A90D9"
                    BorderThickness="2"
                    CornerRadius="12"
                    Margin="0,0,10,0"
                    Background="{Binding IsDragOver, Converter={StaticResource DragOverBrushConverter}}"
                    Cursor="Hand">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Source="{Binding SelectedImage}"
                           Stretch="Uniform"
                           Margin="20"
                           Visibility="{Binding SelectedImage, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <StackPanel x:Name="DropHint"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding SelectedImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                        <Ellipse Width="80" Height="80" Fill="#FFE8E8E8" Margin="0,0,0,20">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="📷" FontSize="48" Margin="-80,-80,0,0"/>
                        <TextBlock Text="拖拽图片到这里" FontSize="18" Foreground="#FF666666" Margin="0,20,0,0"/>
                        <TextBlock Text="或点击上方按钮选择图片" FontSize="14" Foreground="#FF999999"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Effect="{StaticResource Shadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="识别结果"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF333333"
                               Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border CornerRadius="8" Background="#FFF8F8F8" Padding="2">
                            <TextBox x:Name="ResultTextBox"
                                     Text="{Binding RecognizedText}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="14"
                                     Padding="15"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MinHeight="300"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" Padding="20" Effect="{StaticResource Shadow}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                    <Path Width="16" Height="16" Fill="#FF4A90D9"
                          Data="M12 4v16M4 12h16"
                          Margin="0,0,10,0"/>
                    <TextBlock Text="支持格式: PNG, JPG, JPEG, BMP" FontSize="12" Foreground="#FF666666"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                    <Path Width="15" Height="15" Fill="#FF4A90D9"
                          Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-2 15l-5-5 1.4-1.4L10 14.2l7.6-7.6L19 8l-9 9z"
                          Margin="0,0,10,0" Stretch="Fill"/>
                    <TextBlock Text="离线使用，无需网络" FontSize="12" Foreground="#FF666666"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Width="15" Height="15" Fill="#FF4A90D9"
                          Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-1 17.9c-4-.5-7-3.9-7-7.9 0-.6.1-1.2.2-1.8L9 15v1c0 1.1.9 2 2 2v1.9zm6.9-2.5c-.3-.8-1-1.4-1.9-1.4h-1v-3c0-.6-.4-1-1-1H8v-2h2c.6 0 1-.4 1-1V7h2c1.1 0 2-.9 2-2v-.4c2.9 1.2 5 4.1 5 7.4 0 2.1-.8 4-2.1 5.4z"
                          Margin="0,0,10,0" Stretch="Fill"/>
                    <TextBlock Text="支持中文、英文、数字识别" FontSize="12" Foreground="#FF666666"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
